# ─────────────────────────────────────────────────────────────────────────────
# Munshi configuration. Copy to .env and fill in. NEVER commit .env.
# The demo runs end-to-end with ALL of these unset (deterministic offline mode).
# ─────────────────────────────────────────────────────────────────────────────

# --- Reasoning: Groq ---------------------------------------------------------
# With a key, the tool-using agent runs against Groq. Without one, Munshi runs
# its deterministic reasoner and stamps every decision reasoner="heuristic", so
# no result is ever presented as a model's when no model ran.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high. Applies to gpt-oss models.
GROQ_REASONING_EFFORT=medium

MUNSHI_LLM_TIMEOUT=45
MUNSHI_LLM_CONCURRENCY=8
# Hard ceiling on tool-calling turns per case. An agent that will not decide
# must stop costing money.
MUNSHI_AGENT_MAX_TURNS=6

# --- Razorpay ---------------------------------------------------------------
# Execution adapter: "simulator" (default) | "razorpay_test"
# "razorpay_test" issues REAL calls against Razorpay TEST mode. It will never
# be selected unless you set it explicitly AND supply test-mode keys, and the
# adapter refuses any key id that is not rzp_test_*.
MUNSHI_ADAPTER=simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay dashboard webhook, used for HMAC validation.
# With this unset the webhook endpoint refuses all traffic rather than accepting
# unverified events.
RAZORPAY_WEBHOOK_SECRET=

# --- Runtime ----------------------------------------------------------------
MUNSHI_DB=munshi.db
# Bearer token required by every mutating API route. Generated if unset.
MUNSHI_API_TOKEN=
# Merchant-local timezone used for RBI Fair Practices Code contact windows.
MUNSHI_TIMEZONE=Asia/Kolkata
MUNSHI_RATE_LIMIT=120
